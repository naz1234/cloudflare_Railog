{
  "name": "RosterFile",
  "type": "object",
  "properties": {
    "recordKey": {
      "type": "string",
      "description": "Singleton key for the active shared roster"
    },
    "fileName": {
      "type": "string",
      "description": "Original roster PDF file name"
    },
    "mimeType": {
      "type": "string",
      "description": "Original roster file MIME type"
    },
    "size": {
      "type": "number",
      "description": "Original roster file size in bytes"
    },
    "fileBase64": {
      "type": "string",
      "description": "Original roster PDF encoded for Cloudflare D1 storage"
    },
    "parsed": {
      "type": "object",
      "description": "Parsed OCC roster data",
      "additionalProperties": true
    },
    "updatedAt": {
      "type": "string",
      "description": "Last roster upload timestamp"
    }
  },
  "required": [
    "recordKey"
  ]
}

{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "trainId": {
      "type": "string",
      "description": "Train ID number"
    },
    "requestType": {
      "type": "string",
      "description": "Manual maintenance request type entered by user"
    },
    "customType": {
      "type": "string",
      "description": "Legacy custom type text for older saved records"
    },
    "groupTitle": {
      "type": "string",
      "description": "Optional editable parent title used to group train requests without changing their request type"
    },
    "remark": {
      "type": "string",
      "description": "Optional remark"
    }
  },
  "required": [
    "trainId",
    "requestType"
  ]
}
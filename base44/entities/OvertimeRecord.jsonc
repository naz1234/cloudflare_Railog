{
  "name": "OvertimeRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Overtime duty date in YYYY-MM-DD format"
    },
    "type": {
      "type": "string",
      "enum": ["OT", "RDOT"],
      "description": "Normal overtime or rest-day overtime"
    },
    "startTime": {
      "type": "string",
      "description": "Duty start time in HH:mm format"
    },
    "endTime": {
      "type": "string",
      "description": "Duty end time in HH:mm format"
    },
    "hours": {
      "type": "number",
      "description": "Recorded overtime hours"
    },
    "remark": {
      "type": "string",
      "description": "Optional note for the overtime duty"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": ["date", "type", "startTime", "endTime", "hours"]
}

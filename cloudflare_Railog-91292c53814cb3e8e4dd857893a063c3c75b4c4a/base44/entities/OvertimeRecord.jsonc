{
  "name": "OvertimeRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Extension or RDOT duty date in YYYY-MM-DD format"
    },
    "type": {
      "type": "string",
      "enum": ["RDOT", "EXTENSION"]
    },
    "startTime": {
      "type": "string"
    },
    "endTime": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "remark": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": ["date", "type", "startTime", "endTime", "hours"]
}

{
  "name": "TrainRem",
  "type": "object",
  "properties": {
    "depot": {
      "type": "string",
      "description": "west or east"
    },
    "selectedPreset": {
      "type": "string",
      "description": "Active preset label e.g. weekday, saturday, friday, 9am, 7pm, 12am"
    },
    "key": {
      "type": "string",
      "description": "Unique key combining depot and selectedPreset, e.g. west_weekday or east_saturday"
    },
    "rows": {
      "type": "array",
      "description": "Array of train removal row entries",
      "items": {
        "type": "object",
        "properties": {
          "rowId": {
            "type": "string",
            "description": "Stable row ID used by the app to update the same row instead of creating stale/duplicate row data"
          },
          "trainId": {
            "type": "string"
          },
          "tid": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          }
        },
        "required": [
          "rowId"
        ]
      }
    },
    "updatedAt": {
      "type": "string",
      "description": "Last Train Rem client-side save timestamp used to prevent older duplicate records from overwriting the latest Train ID inputs"
    },
    "presetRows": {
      "type": "object",
      "description": "Saved Train Rem row sets for each preset so switching 9am, 7pm, 12am, Fri, Sat or PH restores the exact previous entries.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rowId": {
              "type": "string",
              "description": "Stable row ID used by the app to update the same row instead of creating stale/duplicate row data"
            },
            "trainId": {
              "type": "string"
            },
            "tid": {
              "type": "string"
            },
            "timing": {
              "type": "string"
            },
            "remark": {
              "type": "string"
            }
          },
          "required": [
            "rowId"
          ]
        }
      }
    }
  },
  "required": [
    "depot",
    "selectedPreset",
    "key",
    "rows"
  ]
}
